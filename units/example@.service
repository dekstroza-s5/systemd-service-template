[Unit]
Description=Example application (%i)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=example
Group=example
EnvironmentFile=/etc/example/%i.env
ExecStart=/opt/example/bin/server --config /etc/example/%i.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/example
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
